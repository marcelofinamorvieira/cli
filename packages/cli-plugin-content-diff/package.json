{
  "name": "@datocms/cli-plugin-content-diff",
  "version": "4.2.1",
  "description": "Compare DatoCMS environments and apply reviewable content bundles",
  "keywords": ["datocms", "cli", "content", "diff", "bundle"],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "author": "DatoCMS <support@datocms.com>",
  "homepage": "https://github.com/datocms/cli#readme",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": ["/lib", "/npm-shrinkwrap.json", "/oclif.manifest.json"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datocms/cli.git",
    "directory": "packages/cli-plugin-content-diff"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\" && tsc -b",
    "postpack": "rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest",
    "test": "mocha --timeout 200000 --require ts-node/register --forbid-only \"test/rewrite/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p test/tsconfig.json --noEmit",
    "package:check": "node scripts/package-check.mjs"
  },
  "bugs": {
    "url": "https://github.com/datocms/cli/issues"
  },
  "dependencies": {
    "@datocms/cli-utils": "^4.2.0",
    "@oclif/core": "^4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@datocms/cma-client": "^6.1.0",
    "@datocms/cma-client-node": "^6.1.0",
    "@datocms/rest-client-utils": "^6.1.0",
    "mocha": "^12.0.2",
    "oclif": "^4",
    "typescript": "5.7.2",
    "ts-node": "^10.2.1"
  },
  "oclif": {
    "commands": "./lib/commands",
    "repositoryPrefix": "<%- repo %>/blob/@datocms/cli-plugin-content-diff@<%- version %>/packages/cli-plugin-content-diff/<%- commandPath %>",
    "topics": {
      "content": {
        "description": "Compare environments and apply content bundles"
      }
    }
  }
}
