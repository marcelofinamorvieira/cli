{
  "name": "@datocms/cli-plugin-content-dump",
  "version": "4.2.1",
  "description": "Export a DatoCMS environment's content to a dump, and import a dump into an empty sandbox environment",
  "keywords": [
    "datocms",
    "cli",
    "content",
    "dump",
    "export",
    "import",
    "backup"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "DatoCMS <support@datocms.com>",
  "homepage": "https://github.com/datocms/cli#readme",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": ["/lib", "/npm-shrinkwrap.json", "/oclif.manifest.json"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datocms/cli.git",
    "directory": "packages/cli-plugin-content-dump"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\" && tsc -b",
    "postpack": "rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest",
    "test": "mocha --timeout 30000 --require ts-node/register --forbid-only \"test/*.test.ts\"",
    "test:integration": "mocha --timeout 1200000 --require ts-node/register --forbid-only \"test/live/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p test/tsconfig.json --noEmit"
  },
  "bugs": {
    "url": "https://github.com/datocms/cli/issues"
  },
  "dependencies": {
    "@datocms/cli-utils": "^4.2.0",
    "@oclif/core": "^4",
    "tslib": "^2.8.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@datocms/cma-client": "^6.1.0",
    "@datocms/cma-client-node": "^6.1.0",
    "@datocms/rest-client-utils": "^6.1.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "oclif": "^4"
  },
  "oclif": {
    "commands": "./lib/commands",
    "repositoryPrefix": "<%- repo %>/blob/@datocms/cli-plugin-content-dump@<%- version %>/packages/cli-plugin-content-dump/<%- commandPath %>",
    "topics": {
      "content": {
        "description": "Export an environment's content to a dump, and import a dump into an empty sandbox environment"
      }
    }
  }
}
