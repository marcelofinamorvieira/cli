{
  "compilerOptions": {
    "declaration": true,
    "importHelpers": true,
    "module": "Node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "target": "es2019",
    "lib": ["es2022"],
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*"]
}
